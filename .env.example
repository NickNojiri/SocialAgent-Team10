# Discord
# The token for your Discord bot
DISCORD_TOKEN=your-discord-bot-token-here
# Set to a specific channel ID to limit the bot, or 0 for anywhere
BOT_CHANNEL_ID=0

# Ollama
# URL for the Ollama service (host.docker.internal reaches the host machine;
# run_local.ps1 overrides this to localhost automatically)
OLLAMA_URL=http://host.docker.internal:11434
# The LLM model for reel extraction. llama3.1:8b = best quality;
# llama3.2:3b = ~2-3x faster on CPU with a modest quality cost.
OLLAMA_MODEL=llama3.1:8b

# ── Capture speed knobs (all optional) ──────────────────────────────────
# Whisper model for reel audio: tiny (fastest) | base (default) | small
#WHISPER_MODEL=tiny
# Set to 0 to skip audio transcription entirely — biggest speed win on
# CPU-only machines; cards fall back to caption-only descriptions.
#TRANSCRIBE_ENABLED=0
# How long the browser waits for the IG page to settle (default 8000).
# 4000 shaves ~4s off every capture with little risk.
#SETTLE_TIMEOUT_MS=4000
# Read burned-in on-screen text from the reel's cover image (venue names typed
# over the video). Requires: pip install rapidocr-onnxruntime. Adds a few
# seconds per capture; full video-frame OCR is a future upgrade.
#OCR_ENABLED=1
# Hard per-link time budget for capture stages (default 180s) — a hung backend
# fails that one link fast with a clear reason instead of stalling the bot.
#CAPTURE_BUDGET_S=120

# ── Capture job queue (all optional; ADR-0004, ADR-0005) ────────────────
# Bot side: enqueue captures and poll them with live stage text, instead of
# one long blocking request. Off by default until it has run on staging.
#INGEST_ASYNC=1
# Admin side: keep jobs in data/jobs.db so a restart doesn't lose a capture in
# flight — interrupted jobs are retried once, then failed with a reason.
# Default is in-memory. Turn this on per machine once you've tried it.
#JOB_STORE=sqlite
# Retries for links that timed out and for dropped connections only (default 2;
# 0 turns them off). Extraction failures are never retried.
#INGEST_MAX_RETRIES=2
# Per-capture timing log read by scripts/summarize_captures.py (default
# data/capture_jobs.jsonl); set to off to disable it.
#CAPTURE_LOG=off

# Internal service URLs
# URL for the Recommendation service
RECOMMEND_URL=http://recommend:8003

# Chroma DB
# Path to the Chroma store
CHROMA_PATH=data

# Catalog API auth
# Shared secret the bot uses to sign catalog requests and the admin app (:8010)
# and recommend service (:8003) use to verify them. Without it, anything that can
# reach those ports could read, wipe, or stuff votes in any server's catalog by
# naming its guild_id. setup.ps1 fills this in for you; otherwise run:
#   python scripts/ensure_signing_key.py
# All three processes must see the SAME value. Rotating it invalidates every
# /share link ever issued.
SPOTBOT_SIGNING_KEY=

# Authenticated Instagram source (optional — enables the 95-99% reliability
# fetch path; see docs/IG_AUTH_INGESTION_PLAN.md). Use a DEDICATED BURNER
# account, never a personal one. Requires: pip install instagrapi
# The session cookie is saved to data/ig_session.json (gitignored) so login
# happens once.
IG_USERNAME=
IG_PASSWORD=
