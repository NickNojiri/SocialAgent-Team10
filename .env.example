# Discord
DISCORD_TOKEN=your-discord-bot-token-here

# Set to a specific channel ID to limit the bot to one channel.
# Leave as 0 to respond whenever the bot is @mentioned anywhere.
BOT_CHANNEL_ID=0

# Ollama 
# If Ollama runs on your host machine (default), leave this as-is.
# Docker containers reach your host via host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL="llama:3.2"

#Internal service URLs (wired via Docker network — don't change)
LLM_URL=http://llm:8001
DB_URL=http://db:8002

# Voice transcription (local Whisper via faster-whisper, runs on CPU)
# Model size: tiny | base | small | medium | large-v3
# Bigger = more accurate but slower; "base" is a good default.
WHISPER_MODEL=base
