# Copy to .env and fill in. Never commit the real .env.
# ColdReach reads .env automatically from the project directory.

# --- Who you are -----------------------------------------------------------
CR_FULL_NAME=Jane Doe
CR_EMAIL=jane.doe@gmail.com
CR_ROLE_BLURB=a second-year CS undergraduate looking for research experience
# Multi-line sign-off; \n is not expanded, so keep it to one line or leave blank
# to fall back to "Best,\n<CR_FULL_NAME>".
CR_SIGNATURE=

# --- Credentials -----------------------------------------------------------
# Use an APP PASSWORD, not your account password.
#   Gmail:   enable 2FA, then https://myaccount.google.com/apppasswords
#   Outlook: https://account.live.com/proofs/AppPassword
# CR_EMAIL_PASSWORD covers both SMTP and IMAP. Override individually if needed.
CR_EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
# CR_SMTP_PASSWORD=
# CR_IMAP_PASSWORD=

# --- Transport -------------------------------------------------------------
# Gmail defaults shown. Outlook: smtp-mail.outlook.com:587 / outlook.office365.com:993
CR_SMTP_HOST=smtp.gmail.com
CR_SMTP_PORT=587
CR_IMAP_HOST=imap.gmail.com
CR_IMAP_PORT=993
CR_IMAP_FOLDER=INBOX

# --- Local model -----------------------------------------------------------
CR_OLLAMA_HOST=http://127.0.0.1:11434
CR_OLLAMA_MODEL=qwen2.5:3b
# "0" unloads the model as soon as each call returns, so nothing sits in RAM
# between cron runs. Use "5m" if you would rather keep it warm.
CR_OLLAMA_KEEP_ALIVE=0
CR_OLLAMA_NUM_CTX=2048
CR_OLLAMA_TIMEOUT=180

# --- Behaviour -------------------------------------------------------------
CR_TIMEZONE=America/Los_Angeles
CR_DB_PATH=professors.db
CR_ICS_DIR=invites
CR_MAX_DRAFT_WORDS=100
CR_MEETING_MINUTES=15
# Earliest a proposed meeting may be, in hours from now.
CR_LEAD_TIME_HOURS=48
# Local-time hours ColdReach is willing to propose (weekdays only).
CR_MEETING_HOURS=10,11,14,15,16
# Deliverability guards.
CR_MAX_SENDS_PER_RUN=15
CR_SEND_DELAY_SECONDS=45
# Socket timeout for SMTP and IMAP, in seconds.
CR_NET_TIMEOUT=30
CR_DRY_RUN=false
